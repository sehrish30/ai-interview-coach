# Supabase project settings (Project Settings -> API Keys).
# Uses the modern publishable/secret key pair, not the legacy anon/service_role
# keys (Supabase is deprecating those by end of 2026).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser or commit a real value.
SUPABASE_SECRET_KEY=sb_secret_...

# Model provider. Format: "<provider>/<model-name>". Requires the matching
# provider API key env var below. Pick ONE block:
#
# OpenAI (paid):
# AI_MODEL=openai/gpt-5.1
# OPENAI_API_KEY=sk-...
#
# Google Gemini (free tier available — get a key at https://aistudio.google.com/apikey):
AI_MODEL=google/gemini-2.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=...
#
# xAI Grok (requires billing on your xAI account):
# AI_MODEL=xai/grok-4
# XAI_API_KEY=...

# Feature flags — both default to false to stay within free-tier limits.
ENABLE_COMPANY_RESEARCH=false
ENABLE_VOICE_INTERVIEW=false

# Optional: override where Mastra's local memory/storage SQLite file lives.
# Defaults to ./mastra.db in the project root.
# MASTRA_STORAGE_DB_URL=file:./mastra.db
# MASTRA_MEMORY_DB_URL=file:./mastra.db
